# Copy to .env and replace every value marked CHANGE_ME before running `docker compose up`.

# Public port for the web application
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=chargeopt
POSTGRES_USER=chargeopt
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password

# Authentication: JWT signing secret (at least 32 random characters, e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_secret
JWT_EXPIRE_MINUTES=480
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# Fleet locale
FLEET_TIMEZONE=Asia/Kolkata
CURRENCY=INR

# Demo data: when true and the database is empty, demo depots, chargers, tariffs,
# a 100-vehicle fleet and six role-based demo users are created. All demo users
# share DEMO_USER_PASSWORD (minimum 8 characters).
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=CHANGE_ME_demo_password

# Optional: enables POST /api/integrations/fleet-sync and GET /api/integrations/schedule-export
# (send it as the X-Integration-Key header; minimum 24 characters)
INTEGRATION_API_KEY=

# Optional: OCPP 1.6-J security profile 1 (HTTP Basic) password for charge points
OCPP_BASIC_AUTH_PASSWORD=

# Simulated charger telemetry for chargers without an OCPP connection
SIMULATION_ENABLED=true
SIMULATION_TICK_SECONDS=5

LOG_LEVEL=INFO
ENVIRONMENT=production
